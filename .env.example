# PrepPilot — Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to version control.

# -----------------------------------------------------------------------
# Supabase (required)
# Find these in: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------
# Gemini API Keys (Edge Function secrets — NOT frontend env vars)
# Set these in: Supabase Dashboard → Edge Functions → Secrets
# DO NOT add GEMINI_API_KEY_* here. They must never reach the browser.
# -----------------------------------------------------------------------
# GEMINI_API_KEY_1=...   ← set in Supabase Edge Function secrets
# GEMINI_API_KEY_2=...   ← fallback key
# GEMINI_API_KEY_3=...   ← second fallback key
